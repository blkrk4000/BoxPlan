{
  "name": "boxplan-app",
  "version": "0.4.0",
  "description": "BoxPlan App",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "serve": "serve -s dist -l 3002",
    "prod": "npm run build && npm run serve",
    "prod-pm2": "pm2 start npm --name \"boxplan\" -- run prod",
    "dev-pm2": "pm2 start npm --name \"boxplan-dev\" -- run dev",
    "stop-pm2": "pm2 delete boxplan boxplan-dev"
  },
  "author": "github.com/blkrk4000",
  "license": "MIT",
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^5.0.0",
    "vite": "^5.0.0",
    "serve": "^14.2.0"
  },
  "dependencies": {}
}